@model ProductDto;


<form action="/ProductSubmit/Update/@Model.ProductId" method="post">
    <div class="mb-3">
        <label class="form-label">Name</label>
        <input type="text" class="form-control" name="ProductName" value="@Model.ProductName">
    </div>
    <div class="mb-3">
        <label class="form-label">Quantity</label>
        <input type="text" class="form-control" name="Quantity" value="@Model.Quantity">
    </div>
    <div class="mb-3">
        <label class="form-label">Price</label>
        <input type="text" class="form-control" name="Price" value="@Model.Price">
    </div>
    <button type="submit" class="btn btn-primary">Update</button>
</form>
