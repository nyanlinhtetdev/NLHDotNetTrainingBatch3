@model ProductDto;

<div class="mb-3">
    <label class="form-label">Name</label>
    <input type="text" id="productName" class="form-control" name="ProductName" value="@Model.ProductName">
</div>
<div class="mb-3">
    <label class="form-label">Quantity</label>
    <input type="text" id="quantity" class="form-control" name="Quantity" value="@Model.Quantity">
</div>
<div class="mb-3">
    <label class="form-label">Price</label>
    <input type="text" id="price" class="form-control" name="Price" value="@Model.Price">
</div>
<button type="button" id="btnUpdate" class="btn btn-primary">Update</button>


@section Scripts{
    <script>
        $('#btnUpdate').click(function(){
            const productName = $('#productName').val();
            const quantity = $('#quantity').val();
            const price = $('#price').val();
            
            $.ajax({
                url: `/ProductAjax/Update/${@Model.ProductId}`,
                type: "POST",
                data: {
                    ProductName : productName,
                    Quantity : quantity,
                    Price: price
                },
                success: function (response){
                    alert(response.Message);
                    location.href = "/ProductAjax";
                },
                error: function (xhr) {
                    alert(xhr.responseText);
                }
            })
        })
    </script>
}