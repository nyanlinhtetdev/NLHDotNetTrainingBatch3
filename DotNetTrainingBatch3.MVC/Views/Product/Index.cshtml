@using DotNetTrainingBatch3.MVCDatabase.AppDbContextModels

@model List<TblProduct>

<h1>Product List</h1>

<a href="/product/create" class="btn btn-success">New Product</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Product ID</th>
            <th>Product Name</th>
            <th>Quantity</th>
            <th>Price</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ProductId</td>
                <td>@item.ProductName</td>
                <td>@item.Quantity</td>
                <td>@item.Price</td>
                <td>
                    <a href="/product/edit/@item.ProductId" class="btn btn-warning btn-sm">Edit</a>
                    <a href="/product/delete/@item.ProductId" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>