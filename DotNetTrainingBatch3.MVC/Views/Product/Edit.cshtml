@using DotNetTrainingBatch3.MVCDatabase.AppDbContextModels
@model TblProduct

<form action="/product/update/@Model.ProductId" method="post">
    <div class="mb-3">
        <label class="form-label">Name</label>
        <input type="text" class="form-control" name="ProductName" value="@Model.ProductName" required>
    </div>
    <div class="mb-3">
        <label class="form-label">Quantity</label>
        <input type="number" class="form-control" name="Quantity" value="@Model.Quantity" required>
    </div>
    <div class="mb-3">
        <label class="form-label">Price</label>
        <input type="number" class="form-control" name="Price" value="@Model.Price" required>
    </div>
    <button type="submit" class="btn btn-primary">Update</button>
</form>
